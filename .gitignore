# Dependencies
node_modules/
.pnp/
.pnp.js

# Build Outputs
dist/
build/
out/
.next/

# Environment Variables & Secrets (Keep .env.example tracked, ignore real secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Allow tracked .env.example files
!.env.example
!*/.env.example
!apps/*/.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor & IDE Configs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# TypeScript Cache
*.tsbuildinfo

# Coverage and test output
coverage/
.nyc_output/

# Temporary / Scratch
scratch/
tmp/
temp/
