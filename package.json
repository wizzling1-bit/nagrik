{
  "name": "naagrik-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Location-based local news, citizen journalism and short-video platform",
  "workspaces": [
    "packages/shared-types",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace=apps/web",
    "dev:backend": "npm run dev --workspace=apps/api",
    "dev:legacy": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build:frontend",
    "build:all": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm run build --workspace=apps/web",
    "build:backend": "npm run build --workspace=packages/shared-types && npm run build --workspace=apps/api",
    "start:backend": "node apps/api/dist/index.js",
    "test:api": "npm run test --workspace=apps/api",
    "test:mobile": "cd apps/mobile && flutter test",
    "analyze:mobile": "cd apps/mobile && flutter analyze",
    "test:all": "npm run test:api && npm run test:mobile"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "next": "^16.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
